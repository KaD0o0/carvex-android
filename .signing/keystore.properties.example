# 复制为 .signing/keystore.properties（已被 .gitignore 忽略）后填入你的签名信息。
# Android Studio：Build > Generate Signed Bundle / APK > APK > Create new...，
# 把密钥保存到 .signing/release.jks，再把下面的值填成一致。
# storeFile 相对仓库根目录解析（写成绝对路径也可以，CI 就是这么做的）。
storeFile=.signing/release.jks
storePassword=把密钥库口令写在这里
keyAlias=carwith-bridge
keyPassword=把密钥口令写在这里
